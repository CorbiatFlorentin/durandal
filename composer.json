{
    "name": "corbiatflorentin/durandal",
    "description": "Tests de résilience pour PHP et Symfony : injection déterministe de pannes réseau (latence, erreurs HTTP, timeouts, coupures).",
    "type": "library",
    "license": "MIT",
    "keywords": ["testing", "resilience", "chaos", "fault-injection", "http-client", "psr-18", "symfony", "phpunit", "pest"],
    "authors": [
        {
            "name": "Florentin Corbiat"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.29 || ^0.30 || ^0.31",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Durandal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Durandal\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "infection": "infection --threads=max --show-mutations",
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
